// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//<<<=== models =====>>>
model Merchant {
  id        String   @id @default(uuid())
  name      String
  country   String?
  currency  String?
  timezone  String?
  isActive  Boolean  @default(true)
  status    String? // optional: pending/active/suspended
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   // ✅ Settings (v1)
  receiptFooter    String?
  taxEnabled       Boolean @default(false)
  taxRate          Float   @default(0)
  pricesIncludeTax Boolean @default(false)

  stores        Store[]
  products      Product[]
  users         User[]
  roles         Role[]
  stockLedgers  StockLedger[]
  sales         Sale[]
  refunds       Refund[]
  shiftSessions ShiftSession[]
  inventories   Inventory[]
  
  // Advanced Settings (v2)
  paymentMethodSettings PaymentMethodSettings? @relation("PaymentMethodSettings")
  refundPolicySettings  RefundPolicySettings? @relation("RefundPolicySettings")
  shiftManagementSettings ShiftManagementSettings? @relation("ShiftManagementSettings")
  notificationSettings  NotificationSettings? @relation("NotificationSettings")
  securitySettings      SecuritySettings? @relation("SecuritySettings")
  backupSettings        BackupSettings? @relation("BackupSettings")
  receiptSettings       ReceiptSettings? @relation("ReceiptSettings")
  receiptTemplates      ReceiptTemplate[] @relation("ReceiptTemplates")
  salesSettings         SalesSettings? @relation("SalesSettings")
  integrationSettings   IntegrationSettings? @relation("IntegrationSettings")
  discountRules         DiscountRule[] @relation("MerchantDiscountRules")
}

model Store {
  id         String   @id @default(uuid())
  merchantId String
  name       String
  code       String?
  address    String?
  phone      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

    // ✅ Settings (v1)
  lowStockThreshold Int    @default(10)
  receiptPrefix     String?
  openingCashDefault Float @default(0)

  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  users         User[]
  stockLedgers  StockLedger[]
  sales         Sale[]
  refunds       Refund[]
  shiftSessions ShiftSession[]
  inventories   Inventory[]
}

model User {
  id           String    @id @default(uuid())
  merchantId   String
  storeId      String?
  fullName     String
  email        String    @unique
  phone        String?
  passwordHash String
  status       String? // active/disabled
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  store         Store?         @relation(fields: [storeId], references: [id])
  shiftSessions ShiftSession[] @relation("CashierShiftSessions")
  userRoles     UserRole[]
}

model Role {
  id         String   @id @default(uuid())
  merchantId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant  Merchant         @relation(fields: [merchantId], references: [id])
  userRoles UserRole[]
  rolePerms RolePermission[]

  @@unique([merchantId, name])
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  rolePerms RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model Product {
  id         String @id @default(uuid())
  merchantId String

  name     String
  category String @default("Uncategorized")
  sku      String?
  barcode  String?
  imageUrl String?
  price    Float

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant     Merchant      @relation(fields: [merchantId], references: [id])
  stockLedgers StockLedger[]
  saleItems    SaleItem[]
  refundItems  RefundItem[]
  inventories  Inventory[]

  @@unique([merchantId, sku])
  @@unique([merchantId, barcode])
  @@index([merchantId])
  @@index([merchantId, isDeleted])
}

model StockLedger {
  id         String @id @default(uuid())
  merchantId String
  storeId    String

  productId String
  type      String // "IN" | "OUT" | "ADJUST"
  qtyChange Int
  unitCost  Float?
  reference String? // e.g. "SALE:<saleId>" or "STOCKIN:<id>"
  note      String?

  createdBy String? // userId
  createdAt DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])
  store    Store    @relation(fields: [storeId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([merchantId, storeId])
  @@index([merchantId, productId])
  @@index([merchantId, storeId, productId])
  @@index([createdAt])
}

model Sale {
  id         String  @id @default(uuid())
  merchantId String
  storeId    String
  terminalId String?
  cashierId  String?

  receiptNo String?
  status    String  @default("COMPLETED") // COMPLETED | VOIDED | HELD

  subtotal Float
  discount Float @default(0)
  discountPromoCode String? // Track which promo code was used
  tax      Float @default(0)
  total    Float

  clientTxnId    String? // for offline idempotency later
  shiftSessionId String?

  createdAt DateTime @default(now())

  merchant     Merchant      @relation(fields: [merchantId], references: [id])
  store        Store         @relation(fields: [storeId], references: [id])
  shiftSession ShiftSession? @relation(fields: [shiftSessionId], references: [id])

  items    SaleItem[]
  payments Payment[]
  refunds  Refund[]

  @@unique([merchantId, clientTxnId])
  @@index([merchantId, storeId, shiftSessionId, createdAt])
}

model SaleItem {
  id        String @id @default(uuid())
  saleId    String
  productId String

  nameSnap  String
  priceSnap Float
  qty       Int
  lineTotal Float

  sale        Sale         @relation(fields: [saleId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  refundItems RefundItem[]

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id        String   @id @default(uuid())
  saleId    String
  method    String // CASH | MOMO | CARD | SPLIT
  amount    Float
  reference String?
  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

model ReceiptCounter {
  id         String @id @default(uuid())
  merchantId String
  storeId    String
  dateKey    String // YYYYMMDD
  lastNumber Int    @default(0)

  @@unique([merchantId, storeId, dateKey])
}

model Refund {
  id         String @id @default(uuid())
  merchantId String
  storeId    String
  saleId     String

  cashierId String?
  reason    String?
  restock   Boolean @default(true)

  amount         Float
  createdAt      DateTime @default(now())
  shiftSessionId String?

  // ✅ Approval workflow (v1)
  approvalStatus String   @default("PENDING_APPROVAL") // PENDING_APPROVAL | APPROVED | REJECTED
  approvedBy     String?  // userId of approver
  approvedAt     DateTime?
  rejectionReason String?

  merchant     Merchant      @relation(fields: [merchantId], references: [id])
  store        Store         @relation(fields: [storeId], references: [id])
  sale         Sale          @relation(fields: [saleId], references: [id])
  shiftSession ShiftSession? @relation(fields: [shiftSessionId], references: [id])

  items RefundItem[]

  @@index([merchantId, storeId, shiftSessionId, createdAt])
  @@index([merchantId, storeId, approvalStatus])
  @@index([saleId])
}

model RefundItem {
  id         String @id @default(uuid())
  refundId   String
  saleItemId String
  productId  String

  qty    Int
  amount Float

  refund   Refund   @relation(fields: [refundId], references: [id])
  saleItem SaleItem @relation(fields: [saleItemId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([refundId])
  @@index([saleItemId])
  @@index([productId])
}

model ShiftSession {
  id         String @id @default(uuid())
  merchantId String
  storeId    String
  cashierId  String

  openedAt DateTime  @default(now())
  closedAt DateTime?
  status   String    @default("OPEN") // OPEN | CLOSED

  openingCash  Float  @default(0)
  closingCash  Float?
  expectedCash Float?
  difference   Float?

  note String?

  sales   Sale[]
  refunds Refund[]

  merchant Merchant @relation(fields: [merchantId], references: [id])
  store    Store    @relation(fields: [storeId], references: [id])
  cashier  User     @relation("CashierShiftSessions", fields: [cashierId], references: [id])

  @@index([merchantId, storeId, status])
  @@index([cashierId, openedAt])
}

model Inventory {
  id         String @id @default(uuid())
  merchantId String
  storeId    String
  productId  String

  onHand    Int      @default(0)
  reserved  Int      @default(0) // optional for future
  updatedAt DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])
  store    Store    @relation(fields: [storeId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([merchantId, storeId, productId])
  @@index([merchantId, storeId])
  @@index([productId])
}

// POS Settings Models
model PaymentMethodSettings {
  id         String @id @default(uuid())
  merchantId String @unique
  
  // Payment method toggles
  enableCash       Boolean @default(true)
  enableCard       Boolean @default(true)
  enableMobileMoney Boolean @default(true)
  enableCheck      Boolean @default(false)
  enableBankTransfer Boolean @default(false)
  
  // Surcharge settings
  cardSurchargePercent      Float @default(0)
  mobileMoneysSurchargePercent Float @default(0)
  checkProcessingFee        Float @default(0)
  bankTransferFee           Float @default(0)
  
  // Card settings
  cardProcessorName String?
  cardProcessorKey  String?
  cardProcessorSecret String?
  
  // Mobile money settings
  mobileMoneyProvider String? // MTN, VODAFONE, AIRTEL, etc
  mobileMoneyApiKey   String?
  
  // Bank transfer settings
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  merchant Merchant @relation("PaymentMethodSettings", fields: [merchantId], references: [id])
  
  @@index([merchantId])
}

model RefundPolicySettings {
  id         String @id @default(uuid())
  merchantId String @unique
  
  // Refund window
  refundWindowDays          Int   @default(30)
  maxRefundPercentage       Float @default(100)
  
  // Approval requirements
  requireApprovalAboveAmount Float @default(1000)
  requireManagerApproval     Boolean @default(true)
  requireAdminApproval       Boolean @default(false)
  
  // Restock and fees
  autoRestockItems          Boolean @default(true)
  restockFeePercent         Float @default(0)
  minRefundAmount           Float @default(0)
  maxRefundsPerDay          Int    @default(0) // 0 = unlimited
  
  // Receipt handling
  printRefundReceipt        Boolean @default(true)
  refundReceiptPrefix       String  @default("REF-")
  
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  merchant Merchant @relation("RefundPolicySettings", fields: [merchantId], references: [id])
  
  @@index([merchantId])
}

model ShiftManagementSettings {
  id         String @id @default(uuid())
  merchantId String @unique
  
  // Shift logistics
  autoCloseTime               String?  // HH:MM format, e.g., "22:00"
  allowLateCloseMinutes       Int      @default(60)
  requireOpeningCash          Boolean  @default(true)
  requireClosingBalance       Boolean  @default(true)
  
  // Variance / discrepancy
  varianceTolerancePercent    Float    @default(2) // Accept ±2% variance
  toleranceAmount             Float    @default(0)  // Or fixed amount
  
  // Approval rules
  requireApprovalForVariance Boolean  @default(true)
  varianceApprovalThreshold   Float    @default(100)
  requireApprovalForOvertime  Boolean  @default(false)
  overtimeThresholdMinutes    Int      @default(120) // 2 hours
  
  // Shift restrictions
  maxShiftDurationMinutes     Int      @default(480) // 8 hours
  minBreakTimeMinutes         Int      @default(30)
  
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  merchant Merchant @relation("ShiftManagementSettings", fields: [merchantId], references: [id])
  
  @@index([merchantId])
}

model NotificationSettings {
  id         String @id @default(uuid())
  merchantId String @unique
  
  // Stock notifications
  sendLowStockAlerts        Boolean @default(true)
  lowStockThreshold         Int     @default(10)
  sendOutOfStockAlerts      Boolean @default(true)
  
  // Sales notifications
  enableEndOfDayReport      Boolean @default(true)
  endOfDayReportTime        String  @default("22:00") // HH:MM format
  enableHighValueSaleAlert  Boolean @default(true)
  highValueThreshold        Float   @default(0)
  
  // System notifications
  enableUnusualTransactionAlert Boolean @default(true)
  enableErrorNotifications  Boolean @default(true)
  enableRefundAlerts        Boolean @default(true)
  
  // Notification channels
  notifyViaEmail            Boolean @default(true)
  notifyViaSMS              Boolean @default(false)
  notifyViaInApp            Boolean @default(true)
  
  // Alert recipients
  alertEmails               String  @default("") // Comma-separated
  alertPhoneNumbers         String  @default("") // Comma-separated
  
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  merchant Merchant @relation("NotificationSettings", fields: [merchantId], references: [id])
  
  @@index([merchantId])
}

model SecuritySettings {
  id         String @id @default(uuid())
  merchantId String @unique
  
  // Session management
  sessionTimeoutMinutes       Int     @default(30)
  allowConcurrentSessions     Boolean @default(false)
  maxSessionsPerUser          Int     @default(1)
  
  // Password policy
  minPasswordLength           Int     @default(8)
  requireUppercase            Boolean @default(true)
  requireNumbers              Boolean @default(true)
  requireSpecialCharacters    Boolean @default(false)
  passwordExpiryDays          Int     @default(90) // 0 = no expiry
  preventPasswordReuse        Boolean @default(true)
  previousPasswordsToCheck    Int     @default(5)
  
  // Authentication
  enableTwoFactor             Boolean @default(false)
  twoFactorMethod             String  @default("TOTP") // TOTP, SMS, EMAIL
  
  // Login restrictions
  maxFailedLoginAttempts      Int     @default(5)
  lockoutDurationMinutes      Int     @default(15)
  requireIPWhitelist          Boolean @default(false)
  allowedIPs                  String  @default("") // Comma-separated
  
  // Audit
  logAllActions               Boolean @default(true)
  retentionDays               Int     @default(90)
  
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  merchant Merchant @relation("SecuritySettings", fields: [merchantId], references: [id])
  
  @@index([merchantId])
}

model BackupSettings {
  id         String @id @default(uuid())
  merchantId String @unique
  
  // Backup scheduling
  enableAutoBackup            Boolean @default(true)
  backupFrequency             String  @default("DAILY") // DAILY, WEEKLY, MONTHLY
  backupTime                  String  @default("02:00") // HH:MM format
  backupDayOfWeek             Int     @default(1) // 1=Monday, only for WEEKLY
  backupDayOfMonth            Int     @default(1) // 1-31, only for MONTHLY
  
  // Backup retention
  retentionDays               Int     @default(30)
  maxBackupCount              Int     @default(10)
  
  // Backup destination
  backupDestination           String  @default("LOCAL") // LOCAL, CLOUD, BOTH
  cloudProvider               String? // AWS, GOOGLE, AZURE
  cloudBucketName             String?
  cloudAccessKey              String?
  cloudSecretKey              String?
  
  // Export formats
  enableDatabaseExport        Boolean @default(true)
  enableInvoiceExport         Boolean @default(true)
  enableInventoryExport       Boolean @default(true)
  enableFinancialExport       Boolean @default(true)
  
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  merchant Merchant @relation("BackupSettings", fields: [merchantId], references: [id])
  
  @@index([merchantId])
}

model ReceiptSettings {
  id         String @id @default(uuid())
  merchantId String @unique
  
  // Receipt format
  receiptWidth                String  @default("80MM") // 80MM, 58MM
  useLogoOnReceipt            Boolean @default(true)
  logoUrl                     String?
  
  // Merchant/Store branding
  merchantName                String  @default("VIRNYX POS")
  storeName                   String  @default("Sales Receipt")
  
  // Receipt content
  customHeader                String? // Max 100 chars
  customFooter                String? // Max 300 chars
  displayLogo                 Boolean @default(true)
  displayMerchantName         Boolean @default(true)
  displayStoreName            Boolean @default(true)
  displayTaxId                Boolean @default(false)
  displayCashierName          Boolean @default(true)
  displayReceiptNumber        Boolean @default(true)
  displayTimestamp            Boolean @default(true)
  
  // Item details on receipt
  showProductSKU              Boolean @default(false)
  showProductDescription      Boolean @default(true)
  showUnitPrice               Boolean @default(true)
  showQuantity                Boolean @default(true)
  showLineTotal               Boolean @default(true)
  
  // Totals and taxes
  displaySubtotal             Boolean @default(true)
  displayTaxBreakdown         Boolean @default(true)
  displayTotal                Boolean @default(true)
  displayChangeDue            Boolean @default(true)
  
  // Payment details
  showPaymentMethod           Boolean @default(true)
  showPaymentReference        Boolean @default(false)
  
  // Messages
  thankYouMessage             String? // Max 100 chars
  returnsExchangeMessage      String? // Max 100 chars
  discountMessage             String? // Max 100 chars
  
  // Printing
  printerType                 String  @default("THERMAL") // THERMAL, INKJET, GENERIC
  printBarcode                Boolean @default(true)
  printQRCode                 Boolean @default(false)
  
  // Digital
  enableEmailReceipt          Boolean @default(false)
  enableSMSReceipt            Boolean @default(false)
  
  activeTemplateId            String?
  
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  merchant Merchant @relation("ReceiptSettings", fields: [merchantId], references: [id])
  
  @@index([merchantId])
  @@index([activeTemplateId])
}

model ReceiptTemplate {
  id         String @id @default(uuid())
  merchantId String
  name       String
  description String?
  isDefault  Boolean @default(false)
  
  // Template content (copy of fields from ReceiptSettings)
  receiptWidth                String  @default("80MM")
  useLogoOnReceipt            Boolean @default(true)
  logoUrl                     String?
  merchantName                String  @default("VIRNYX POS")
  storeName                   String  @default("Sales Receipt")
  
  customHeader                String?
  customFooter                String?
  displayLogo                 Boolean @default(true)
  displayMerchantName         Boolean @default(true)
  displayStoreName            Boolean @default(true)
  displayTaxId                Boolean @default(false)
  displayCashierName          Boolean @default(true)
  displayReceiptNumber        Boolean @default(true)
  displayTimestamp            Boolean @default(true)
  
  showProductSKU              Boolean @default(false)
  showProductDescription      Boolean @default(true)
  showUnitPrice               Boolean @default(true)
  showQuantity                Boolean @default(true)
  showLineTotal               Boolean @default(true)
  
  displaySubtotal             Boolean @default(true)
  displayTaxBreakdown         Boolean @default(true)
  displayTotal                Boolean @default(true)
  displayChangeDue            Boolean @default(true)
  
  showPaymentMethod           Boolean @default(true)
  showPaymentReference        Boolean @default(false)
  
  thankYouMessage             String?
  returnsExchangeMessage      String?
  discountMessage             String?
  
  printerType                 String  @default("THERMAL")
  printBarcode                Boolean @default(true)
  printQRCode                 Boolean @default(false)
  
  enableEmailReceipt          Boolean @default(false)
  enableSMSReceipt            Boolean @default(false)
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  merchant Merchant @relation("ReceiptTemplates", fields: [merchantId], references: [id])
  
  @@unique([merchantId, name])
  @@index([merchantId])
  @@index([isDefault])
}

model SalesSettings {
  id         String @id @default(uuid())
  merchantId String @unique
  
  // Inventory
  allowNegativeStock          Boolean @default(false)
  warnLowStock                Boolean @default(true)
  lowStockThreshold           Int     @default(10)
  autoReorderPoint            Int     @default(0) // 0 = disabled
  
  // Pricing and rounding
  priceRoundingMethod         String  @default("NONE") // NONE, ROUND_UP, ROUND_DOWN, NEAREST
  enableDiscountApproval      Boolean @default(false)
  discountApprovalThreshold   Float   @default(100)
  maxDiscountPercent          Float   @default(50)
  
  // Receipts
  receiptNumberingMethod      String  @default("SEQUENTIAL") // SEQUENTIAL, DAILY_RESET
  nextReceiptNumber           Int     @default(1)
  receiptNumberPrefix         String?
  
  // Refunds and voids
  requireApprovalForVoid      Boolean @default(true)
  voidApprovalThreshold       Float   @default(0) // 0 = always require
  allowOfflineVoid            Boolean @default(false)
  
  // Discounts
  enableManualDiscount        Boolean @default(true)
  enableVolumeDiscount        Boolean @default(false)
  enableLoyaltyDiscount       Boolean @default(false)
  
  // Display
  displayItemTotalOnScreen    Boolean @default(true)
  displayRunningTotal         Boolean @default(true)
  requireCustomerName         Boolean @default(false)
  requireCustomerPhone        Boolean @default(false)
  
  // Transactions
  maxTransactionAmount        Float   @default(0) // 0 = unlimited
  minTransactionAmount        Float   @default(0)
  
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  merchant Merchant @relation("SalesSettings", fields: [merchantId], references: [id])
  
  @@index([merchantId])
}

model IntegrationSettings {
  id         String @id @default(uuid())
  merchantId String @unique
  
  // API settings
  enableAPI                   Boolean @default(false)
  apiKey                      String?
  apiSecret                   String?
  apiWebhookUrl               String?
  apiWebhookSecret            String?
  
  // Webhook events
  enableWebhookOnSale         Boolean @default(false)
  enableWebhookOnRefund       Boolean @default(false)
  enableWebhookOnPayment      Boolean @default(false)
  enableWebhookOnInventory    Boolean @default(false)
  
  // SMS Integration
  enableSMS                   Boolean @default(false)
  smsProvider                 String? // TWILIO, VONAGE, LOCAL
  smsApiKey                   String?
  smsApiSecret                String?
  smsSenderName               String?
  
  // Email Integration
  enableEmail                 Boolean @default(false)
  emailProvider               String  @default("SMTP") // SMTP, SENDGRID
  emailSmtpHost               String?
  emailSmtpPort               Int     @default(587)
  emailSmtpUser               String?
  emailSmtpPassword           String?
  emailFromAddress            String?
  emailFromName               String?
  
  // Inventory sync
  enableInventorySync         Boolean @default(false)
  inventorySyncFrequency      String  @default("HOURLY") // REALTIME, HOURLY, DAILY
  externalInventorySystem     String? // ODOO, SHOPIFY, CUSTOM
  inventorySyncUrl            String?
  inventorySyncApiKey         String?
  
  // Accounting integration
  enableAccountingSync        Boolean @default(false)
  accountingSystem            String? // XERO, QUICKBOOKS, MYOB
  accountingSyncApiKey        String?
  accountingSyncFrequency     String  @default("DAILY")
  
  // Third-party integrations
  integratedServices          String  @default("") // Comma-separated: LOYALTY_PROGRAM, INVENTORY_MANAGEMENT, ACCOUNTING, etc
  
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  merchant Merchant @relation("IntegrationSettings", fields: [merchantId], references: [id])
  
  @@index([merchantId])
}

// Discount Rule Engine
model DiscountRule {
  id         String @id @default(uuid())
  merchantId String
  
  // Basic info
  name       String   // e.g., "Senior Discount", "Buy 2 Get 1", "10% Off"
  code       String?  // Optional promo code (unique per merchant)
  description String?
  
  // Rule type and conditions
  type       String   // FIXED (₵ amount), PERCENTAGE (%), BOGO (Buy X Get Y), TIERED (qty-based)
  value      Float    // For FIXED: amount in currency; For PERCENTAGE: percentage (e.g., 10)
  
  // Conditions
  minOrderAmount   Float?   // Minimum subtotal to qualify
  minItemQty       Int?     // Minimum quantity of specific item
  maxDiscount      Float?   // Cap on discount amount
  
  // Applicability
  applicableToAll  Boolean @default(true)
  applicableProductIds String? // JSON array of product IDs: ["id1", "id2", ...]
  
  // Timing
  startsAt DateTime?
  endsAt   DateTime?
  
  // Status
  isActive Boolean @default(true)
  
  // Tracking
  maxUsesTotal     Int?     // Global usage limit
  maxUsesPerCustomer Int?   // Per-customer limit (if tracking customer data)
  usageCount       Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  merchant Merchant @relation("MerchantDiscountRules", fields: [merchantId], references: [id])
  
  @@unique([merchantId, code])
  @@index([merchantId, isActive])
  @@index([merchantId, code])
}
