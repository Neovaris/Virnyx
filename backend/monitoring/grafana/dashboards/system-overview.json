{
  "dashboard": {
    "title": "Virnyx System Overview",
    "description": "Complete monitoring of Virnyx infrastructure, application, and database",
    "tags": ["virnyx", "system", "production"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 0,
    "refresh": "10s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "System Health",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "up{job=\"backend\"}",
            "refId": "A",
            "legendFormat": "Backend"
          }
        ]
      },
      {
        "id": 2,
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "(100 - (avg(irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100))",
            "refId": "A",
            "legendFormat": "CPU"
          }
        ]
      },
      {
        "id": 3,
        "title": "Memory Usage",
        "type": "gauge",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
            "refId": "A",
            "legendFormat": "Memory %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "min": 0
          }
        }
      },
      {
        "id": 4,
        "title": "Disk Space",
        "type": "gauge",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})) * 100",
            "refId": "A",
            "legendFormat": "Disk Used %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "min": 0
          }
        }
      },
      {
        "id": 5,
        "title": "Request Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 4, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"backend\"}[5m])",
            "refId": "A",
            "legendFormat": "{{method}} {{path}}"
          }
        ]
      },
      {
        "id": 6,
        "title": "HTTP Error Rate",
        "type": "graph",
        "gridPos": {"x": 8, "y": 4, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"backend\", status=~\"5..\"}[5m])",
            "refId": "A",
            "legendFormat": "{{status}}"
          }
        ]
      },
      {
        "id": 7,
        "title": "Response Time (p95)",
        "type": "graph",
        "gridPos": {"x": 16, "y": 4, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m]))",
            "refId": "A",
            "legendFormat": "p95"
          }
        ]
      },
      {
        "id": 8,
        "title": "PostgreSQL Connections",
        "type": "stat",
        "gridPos": {"x": 0, "y": 10, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "pg_stat_activity_count{datname=\"virnyx\"}",
            "refId": "A",
            "legendFormat": "Active Connections"
          }
        ]
      },
      {
        "id": 9,
        "title": "Database Cache Hit Ratio",
        "type": "gauge",
        "gridPos": {"x": 6, "y": 10, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "rate(pg_stat_database_blks_hit{datname=\"virnyx\"}[5m]) / (rate(pg_stat_database_blks_hit{datname=\"virnyx\"}[5m]) + rate(pg_stat_database_blks_read{datname=\"virnyx\"}[5m])) * 100",
            "refId": "A",
            "legendFormat": "Cache Hit %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "min": 0
          }
        }
      },
      {
        "id": 10,
        "title": "Container Status",
        "type": "stat",
        "gridPos": {"x": 12, "y": 10, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "count(container_last_seen{name=~\"virnyx_.*\"})",
            "refId": "A",
            "legendFormat": "Running Containers"
          }
        ]
      },
      {
        "id": 11,
        "title": "Alerts",
        "type": "stat",
        "gridPos": {"x": 18, "y": 10, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "count(ALERTS{severity=\"critical\", alertstate=\"firing\"})",
            "refId": "A",
            "legendFormat": "Critical"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
